# Copy this file to .env and fill in your tokens.

# Always needed: gated Llama-3.1-8B-Instruct download + general HF downloads.
HUGGINGFACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Needed for PoisonedRAG poison generation and Crescendo attacker/judge
# (nemotron-3-ultra-550b-a55b and deepseek-v4-pro-0813, both served via NIM).
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# Needed only as Crescendo's fallback transport, when NIM's ~40 req/min
# limit is exhausted mid-sweep (see CRESCENDO_LLM_PROVIDER in crescendo.py).
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# Not user-set: RunPod auto-injects this into the pod environment itself.
# RUNPOD_API_KEY=